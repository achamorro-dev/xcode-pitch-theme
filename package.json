{
  "name": "xcode-pitch-dark-theme",
  "displayName": "Xcode Pitch Theme",
  "description": "Xcode-inspired syntax highlighting with pitch-black dark and crisp light themes",
  "version": "1.2.0",
  "publisher": "albertochamorro",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "generate": "python3 scripts/build_light.py",
    "test": "python3 -m unittest discover -s tests -v",
    "build": "npm run generate && npm test && vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/achamorro-dev/xcode-pitch-theme"
  },
  "keywords": [
    "xcode",
    "theme",
    "dark",
    "light",
    "pitch",
    "darkness",
    "full dark",
    "fulldark"
  ],
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Xcode Pitch Dark Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/Xcode Pitch Dark Theme-color-theme.json"
      },
      {
        "label": "Xcode Pitch Dark Bordered Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/Xcode Pitch Dark Bordered Theme-color-theme.json"
      },
      {
        "label": "Xcode Pitch Light",
        "uiTheme": "vs",
        "path": "./themes/Xcode Pitch Light-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
