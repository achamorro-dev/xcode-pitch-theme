    "editorGutter.modifiedBackground": "#284571",
    "editorIndentGuide.activeBackground1": "#ffffff00",
    "editorIndentGuide.background1": "#ffffff00",
    "editorLineNumber.activeForeground": "#26262b",
    "editorLineNumber.foreground": "#65656d",
    "editorLink.activeForeground": "#005cc5",
    "editorOverviewRuler.addedForeground": "#284571",
    "editorOverviewRuler.deletedForeground": "#284571",
    "editorOverviewRuler.errorForeground": "#b42318",
    "editorOverviewRuler.findMatchForeground": "#ffe894",
    "editorOverviewRuler.modifiedForeground": "#284571",
    "editorOverviewRuler.warningForeground": "#795900",
    "editorWarning.foreground": "#795900",
    "editorWhitespace.foreground": "#434c56",
    "editorWidget.background": "#ffffff",
    "editorGroup.border": "#ffffff",
    "errorForeground": "#b42318",
    "focusBorder": "#2f4e6a",
